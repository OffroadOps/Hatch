<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\common.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PlatformTarget>x64</PlatformTarget>
    <StartupObject>RedirectorTester.RedirectorTester</StartupObject>
    <ApplicationManifest>App.manifest</ApplicationManifest>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <Target Name="CopyRedirectorFiles" AfterTargets="Build">
    <ItemGroup>
      <RedirectorFiles Include="$(MSBuildThisFileDirectory)..\Redirector\bin\$(Configuration)\nfapi.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\Redirector\bin\$(Configuration)\nfapi.dll')" />
      <RedirectorFiles Include="$(MSBuildThisFileDirectory)..\Redirector\bin\$(Configuration)\Redirector.bin" Condition="Exists('$(MSBuildThisFileDirectory)..\Redirector\bin\$(Configuration)\Redirector.bin')" />
      <RedirectorFiles Include="$(MSBuildThisFileDirectory)..\Redirector\bin\$(Configuration)\Redirector.pdb" Condition="Exists('$(MSBuildThisFileDirectory)..\Redirector\bin\$(Configuration)\Redirector.pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(RedirectorFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
