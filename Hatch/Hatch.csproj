<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\common.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Configurations>Debug;Release</Configurations>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>App.manifest</ApplicationManifest>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ApplicationIcon>Resources\Netch.ico</ApplicationIcon>
    <IsPackable>false</IsPackable>
    <!-- event handler async void Warning -->
    <NoWarn>VSTHRD100;VSTHRD002;VSTHRD103;VSTHRD105;VSTHRD110;VSTHRD200;CA1416;CS4014;CS8600;CS8602;CS8604;NX0001;NX0002;NX0003</NoWarn>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Default</AnalysisMode>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 优化设置 -->
    <Optimize>true</Optimize>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- 发布配置 - 用于 dotnet publish -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <!-- Windows Forms 不支持 Trimming，禁用 -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- 将本地库也包含在单文件中 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- 自包含发布（包含运行时，体积较大但无需安装.NET） -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 保留多语言支持，确保中文正常显示 -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- 排除不需要打包进单文件的内容 -->
  <ItemGroup>
    <!-- WPF 相关的本地 DLL 必须保留在外部 -->
    <ExcludeFromSingleFile Include="$(OutputPath)D3DCompiler_47_cor3.dll" />
    <ExcludeFromSingleFile Include="$(OutputPath)PenImc_cor3.dll" />
    <ExcludeFromSingleFile Include="$(OutputPath)PresentationNative_cor3.dll" />
    <ExcludeFromSingleFile Include="$(OutputPath)vcruntime140_cor3.dll" />
    <ExcludeFromSingleFile Include="$(OutputPath)wpfgfx_cor3.dll" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ConfigureAwait.Fody" Version="3.3.2">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.9.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="HMBSbige.SingleInstance" Version="6.0.1" />
    <PackageReference Include="MaxMind.GeoIP2" Version="5.4.1" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.20" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.VisualStudio.Threading" Version="17.12.19" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Nullable.Extended.Analyzer" Version="1.15.6169">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Stun.Net" Version="6.2.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="TaskScheduler" Version="2.12.0" />
    <PackageReference Include="WindowsFirewallHelper" Version="2.2.0.86" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="WindowsJobAPI" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Forms\SyncGlobalCheckBox.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Remove="NativeMethods.txt" />
    <None Update="NOTICE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>

  <Target Condition="'$(PublishSingleFile)' == 'true'" AfterTargets="_ComputeFilesToBundle" Name="RemoveDupeAssemblies">
    <ItemGroup>
      <_FilesToBundle Remove="$(PkgMicrosoft_Diagnostics_Tracing_TraceEvent)\build\native\x86\**" />
    </ItemGroup>
  </Target>

  <!-- 复制 Redirector 依赖文件到输出目录 -->
  <Target Name="CopyRedirectorFiles" AfterTargets="Build">
    <ItemGroup>
      <!-- Redirector.bin: 优先当前配置，其次 Release -->
      <RedirectorFiles Include="$(SolutionDir)Redirector\bin\$(Configuration)\Redirector.bin"
                       Condition="Exists('$(SolutionDir)Redirector\bin\$(Configuration)\Redirector.bin')" />
      <RedirectorFiles Include="$(SolutionDir)Redirector\bin\Release\Redirector.bin"
                       Condition="Exists('$(SolutionDir)Redirector\bin\Release\Redirector.bin')" />

      <!-- nfapi.dll: 优先当前配置，其次 Release，再其次 static -->
      <RedirectorFiles Include="$(SolutionDir)Redirector\bin\$(Configuration)\nfapi.dll"
                       Condition="Exists('$(SolutionDir)Redirector\bin\$(Configuration)\nfapi.dll')" />
      <RedirectorFiles Include="$(SolutionDir)Redirector\bin\Release\nfapi.dll"
                       Condition="Exists('$(SolutionDir)Redirector\bin\Release\nfapi.dll')" />
      <RedirectorFiles Include="$(SolutionDir)Redirector\static\nfapi.dll"
                       Condition="Exists('$(SolutionDir)Redirector\static\nfapi.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(RedirectorFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />
    <Message Text="Copied Redirector files to $(OutDir)" Importance="high" />
  </Target>

  <!-- 复制 Storage 中的必需文件到输出目录的 bin 子目录 -->
  <Target Name="CopyStorageFiles" AfterTargets="Build">
    <ItemGroup>
      <StorageFiles Include="$(SolutionDir)Storage\nfdriver.sys" />
      <StorageFiles Include="$(SolutionDir)Storage\stun.txt" />
      <StorageFiles Include="$(SolutionDir)Storage\aiodns.conf" />
      <StorageFiles Include="$(SolutionDir)Storage\tun2socks.bin" Condition="Exists('$(SolutionDir)Storage\tun2socks.bin')" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)bin" />
    <Copy SourceFiles="@(StorageFiles)" DestinationFolder="$(OutDir)bin" SkipUnchangedFiles="true" />
    <Message Text="Copied Storage files to $(OutDir)bin" Importance="high" />
  </Target>

</Project>
